{
  "name": "ship-plan-compliance-auditor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "find src -name '._*' -delete",
    "dev": "npm run clean && vite",
    "build": "npm run clean && tsc --noEmit && vite build",
    "typecheck": "npm run clean && tsc --noEmit",
    "test": "npm run clean && vitest run",
    "build:static": "npm run clean && tsc --noEmit && vite build --mode static --outDir dist-static",
    "preview:static": "vite preview --outDir dist-static --port 4173"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "antd": "^5.22.0",
    "axios": "^1.7.9",
    "i18next": "^26.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
